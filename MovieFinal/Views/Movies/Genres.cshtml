@model IEnumerable<MovieFinal.Data.Genre>

@{
    ViewBag.Title = "Genres";
}

<h2>Genres</h2>

<p>
    <a asp-action="Movies">
        View Movies
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Genre ID</th>
            <th>Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.GenreId</td>
                <td>@genre.Name</td>
            </tr>
        }
    </tbody>
</table>