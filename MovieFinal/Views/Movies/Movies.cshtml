@model IEnumerable<MovieFinal.Data.Movie>

@{
    ViewBag.Title = "Movies";
}

<h2>Movies</h2>

<p>
    <a asp-action="Add" class="btn btn-primary">
        Add Movie
    </a>

    <a asp-action="Genres" class="btn btn-secondary">
        View Genres
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Year</th>
            <th>Rating</th>
            <th>Genre</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Name</td>
                <td>@movie.Year</td>
                <td>@movie.Rating</td>
                <td>@movie.Genre?.Name</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@movie.MovieId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@movie.MovieId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>